APP_ENV=production
APP_DEBUG=0
# Prefixo público. Use /cm1 se o site estiver em https://dominio/cm1
# Deixe vazio se o DocumentRoot for a raiz do domínio.
APP_BASE_PATH=/cm1

DB_CONNECTION=mysql
DB_HOST=localhost
DB_NAME=coninfom_institucional
DB_USER=coninfom_admin
DB_PASS=
DB_CHARSET=utf8mb4

# Usados apenas se a tabela users estiver vazia (instalação sem importar install.sql)
ADMIN_EMAIL=admin@coninfoms.com.br
ADMIN_PASSWORD=admin123

GEMINI_API_KEY=
